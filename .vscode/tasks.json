{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe build active file",
            "command": "g++",
            "args": [
                "-g",
                "program.cpp",
                "Backend.cpp",
                "Frontend.cpp",
                "imgui/imgui.cpp",
                "imgui/imgui_demo.cpp",
                "imgui/imgui_draw.cpp",
                "imgui/imgui_tables.cpp",
                "imgui/imgui_widgets.cpp",
                "imgui/backends/imgui_impl_glfw.cpp",
                "imgui/backends/imgui_impl_opengl3.cpp",
                "-Iimgui",
                "-Iimgui/backends",
                "-o",
                "${workspaceFolder}\\BankingApp.exe",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Generated Task by Debugger."
        }
    ]
}